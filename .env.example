# ============================================================================
# CareSync (Noon) — Environment Configuration Template
# Create a .env.local file in the project root and fill in these values.
# ============================================================================

# 1. Supabase Project Credentials (From your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google OAuth Credentials (For Google Sign-In)
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized Redirect URI: https://<YOUR-PROJECT-ID>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 3. ABDM (Ayushman Bharat Digital Mission) NHA Sandbox Credentials
# Register at: https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=SBX_001294
ABDM_CLIENT_SECRET=your-abdm-client-secret
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway/v0.5

# 4. Email Reminders (Resend API)
RESEND_API_KEY=re_your_resend_api_key

# 5. IoT Smart Box Device Authentication Key
IOT_DEVICE_API_KEY=CARESYNC_IOT_KEY_99882
